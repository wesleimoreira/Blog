@Blog.Api_HostAddress = https://localhost:7125

### ============================================
### USERS
### ============================================

### Registrar usuário
POST {{Blog.Api_HostAddress}}/api/users/register
Content-Type: application/json

{
  "firstName": "João",
  "lastName": "Silva",
  "email": "joao.silva@email.com",
  "password": "Senha123"
}

### 0961c89a-df6e-4c6b-a578-5f57d233cfc2

### Registrar o mesmo usuário novamente
POST {{Blog.Api_HostAddress}}/api/users/register
Content-Type: application/json

{
  "firstName": "João",
  "lastName": "Silva",
  "email": "joao.silva@email.com",
  "password": "Senha123"
}

### ============================================
### USERS - VALIDATION
### ============================================

### Cadastro inválido
POST {{Blog.Api_HostAddress}}/api/users/register
Content-Type: application/json

{
  "firstName": "",
  "lastName": "",
  "email": "email-invalido",
  "password": "123"
}

### ============================================
### AUTHENTICATION
### ============================================

### Login para obter os tokens
# @name login
POST {{Blog.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "joao.silva@email.com",
  "password": "Senha123"
}

### Renovar os tokens
# @name refresh
POST {{Blog.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.data.refreshToken}}"
}

### Reutilizar o refresh token anterior - deve falhar
POST {{Blog.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.data.refreshToken}}"
}

### Login senha inválida
POST {{Blog.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "joao.silva@email.com",
  "password": "SenhaErrada"
}

### Login usuário inexistente
POST {{Blog.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "naoexiste@email.com",
  "password": "Senha123"
}

### Login inválido
POST {{Blog.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "abc",
  "password": ""
}

### ============================================
### JWT / AUTHORIZATION
### ============================================

### Meu perfil - autenticado
GET {{Blog.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.data.accessToken}}

### Meu perfil - sem token
GET {{Blog.Api_HostAddress}}/api/auth/me




### ============================================
###  CATEGORIES
### ============================================


### Criar categoria
# @name createCategory
POST {{Blog.Api_HostAddress}}/api/categories
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "Desenvolvimento .NET",
  "description": "Conteúdos sobre desenvolvimento utilizando a plataforma .NET."
}


### Listar categorias
GET {{Blog.Api_HostAddress}}/api/categories

### Consultar categoria por ID
GET {{Blog.Api_HostAddress}}/api/categories/{{createCategory.response.body.$.id}}


### Atualizar categoria
PUT {{Blog.Api_HostAddress}}/api/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "Desenvolvimento C# e .NET",
  "description": "Conteúdos sobre C#, ASP.NET Core e .NET."
}

### Excluir categoria
DELETE {{Blog.Api_HostAddress}}/api/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}


### ============================================
###  TAGS
### ============================================


### Create Tag
# @name createTag
POST {{Blog.Api_HostAddress}}/api/tags
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "ASP.NET Core"
}

### Get All Tags
GET {{Blog.Api_HostAddress}}/api/tags

### Get Tag By Id
GET {{Blog.Api_HostAddress}}/api/tags/{{createTag.response.body.$.id}}

### Update Tag
PUT {{Blog.Api_HostAddress}}/api/tags/{{createTag.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "ASP.NET Core e Web API"
}

### Delete Tag
DELETE {{Blog.Api_HostAddress}}/api/tags/{{createTag.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}

















